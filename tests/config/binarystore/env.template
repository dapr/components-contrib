# Environment variables for binarystore conformance tests
# Copy this file to .env in the same directory and fill in your values

# Azure Blob Storage - Get from the Azure portal (Access keys)
AzureBlobStorageAccount=your_storage_account_name_here
AzureBlobStorageAccessKey=your_base64_encoded_access_key_here

# Azure Data Lake Storage Gen2 - reuses the Azure Blob Storage account
# credentials above (the account must have a hierarchical namespace enabled).

# AWS S3 (or an S3-compatible provider) - standard AWS credential env vars
# (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION) are also honored.
AWSS3Bucket=your_bucket_name_here
AWS_REGION=us-east-1

# Google Cloud Storage - standard Google ADC env vars are honored.
GCPBucket=your_bucket_name_here

# OCI Object Storage - uses OCI configuration file authentication.
DAPR_TEST_OCI_CONFIG_FILE_PATH=C:\path\to\.oci\config
DAPR_TEST_OCI_CONFIG_PROFILE=DEFAULT
DAPR_TEST_OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..example
DAPR_TEST_OCI_BUCKET_NAME=your_bucket_name_here
