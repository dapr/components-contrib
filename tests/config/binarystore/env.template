# Environment variables for binarystore conformance tests
# Copy this file to .env in the same directory and fill in your values

# Azure Blob Storage - Get from the Azure portal (Access keys)
AzureBlobStorageAccount=your_storage_account_name_here
AzureBlobStorageAccessKey=your_base64_encoded_access_key_here

# Azure Data Lake Storage Gen2 - reuses the Azure Blob Storage account
# credentials above (the account must have a hierarchical namespace enabled).

# AWS S3 (or an S3-compatible provider) - standard AWS credential env vars
# (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_REGION) are also honored.
# CI provisions and cleans up an isolated bucket using the S3 binding Terraform
# scripts and sets AWSS3Bucket automatically; it is not a Key Vault secret.
# For local runs, provide an existing bucket below.
AWSS3Bucket=your_bucket_name_here
AWS_REGION=us-east-1

# Google Cloud Storage - standard Google ADC env vars are honored.
# CI provisions and cleans up an isolated bucket using Terraform and sets
# GCPBucket automatically; it is not a Key Vault secret.
# For local runs, provide an existing bucket below.
GCPBucket=your_bucket_name_here

# OCI Object Storage - uses OCI configuration file authentication.
# CI still requires OCIConfigFile and OCICompartmentOCID in Key Vault. The config
# must include a region and reference a signing key available on the runner.
# The identity needs permission to manage buckets, objects, and multipart uploads
# in the test compartment and to read its Object Storage namespace.
# CI provisions and cleans up an isolated bucket using the OCI CLI and sets
# OCIBucketName automatically; it is not a Key Vault secret.
# For local runs, provide an existing bucket below.
OCIConfigFile=C:\path\to\.oci\config
OCIConfigProfile=DEFAULT
OCICompartmentOCID=ocid1.compartment.oc1..example
OCIBucketName=your_bucket_name_here
